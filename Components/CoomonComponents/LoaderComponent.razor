@if (_isLoading)
{
    <div class="loader-overlay">
        <div class="dot-loader" style="--loader-color: @_color;">
            <div class="dot"></div>
            <div class="dot"></div>
            <div class="dot"></div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool _isLoading { get; set; }

    [Parameter]
    public string _color { get; set; } = "#28a745"; // Default color (green)

    // You can optionally provide logic to dynamically change `_color` or other values if required
}
