<div class="custom-pagination">
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <!-- Previous Button -->
            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                <button class="page-link @(CurrentPage == 1 ? "text-muted" : "text-success")" 
                        @onclick="() => GoToPage(CurrentPage - 1)" 
                        aria-label="Previous" 
                        disabled="@(CurrentPage == 1)">
                    <span aria-hidden="true">&laquo; Prev</span>
                </button>
            </li>

            <!-- Page Number Buttons -->
            @for (int i = 1; i <= TotalPages; i++)
            {
                <li class="page-item @(CurrentPage == i ? "active" : "")">
                    <button class="page-link @(CurrentPage == i ? "text-white bg-success border-success" : "text-success")" 
                            @onclick="() => GoToPage(i)">
                        @i
                    </button>
                </li>
            }

            <!-- Next Button -->
            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                <button class="page-link @(CurrentPage == TotalPages ? "text-muted" : "text-success")" 
                        @onclick="() => GoToPage(CurrentPage + 1)" 
                        aria-label="Next" 
                        disabled="@(CurrentPage == TotalPages)">
                    <span aria-hidden="true">Next &raquo;</span>
                </button>
            </li>
        </ul>
    </nav>
</div>

@code {
    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    private async Task GoToPage(int pageNumber)
    {
        if (pageNumber < 1 || pageNumber > TotalPages)
            return;

        CurrentPage = pageNumber;
        await OnPageChanged.InvokeAsync(pageNumber);
    }
}
