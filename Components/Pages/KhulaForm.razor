@page "/khula-form"

<h3>Khula Management</h3>

<!-- Form to create a new Khula -->
<EditForm Model="khula" OnValidSubmit="HandelSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Form Number:</label>
        <InputText @bind-Value="khula.FormNumber" class="form-control" />
    </div>
    
    <div class="mb-3">
        <label>Nikah Date:</label>
        <InputDate @bind-Value="khula.NikahDate" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Groom Name:</label>
        <InputText @bind-Value="khula.GroomName" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Bride Name:</label>
        <InputText @bind-Value="khula.BrideName" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Add Khula</button>
</EditForm>

<!-- List of Khula records -->
@if (khulas != null)
{
    <table class="table">
        <thead>
            <tr>
                <th>Form Number</th>
                <th>Nikah Date</th>
                <th>Groom Name</th>
                <th>Bride Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var khula in khulas)
            {
                <tr>
                    <td>@khula.FormNumber</td>
                    <td>@timeConversion.GetIndianStandardTime(khula.NikahDate)</td>
                    <td>@khula.GroomName</td>
                    <td>@khula.BrideName</td>
                    <td>
                        <button class="btn btn-warning" @onclick="() => EditKhula(khula)"><i class="bi bi-pencil-square"></i></button>
                        <button class="btn btn-danger" @onclick="() => DeleteKhula(khula.Id)"><i class="bi bi-trash3"></i></button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
