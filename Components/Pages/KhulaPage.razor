@page "/khula"

<!-- Alert -->
<ToasterComponent AlertType="success"
                  AlertHeading="@ToasterHeading"
                  AlertMessage="@ToasterBody"
                  Show="@showSuccessAlert"
                  OnClose="@OnToasterClosed" />

<!-- Search Bar -->
<KhulaSearchBarComponent OnSearch="HandleSearch" />


<!-- Button to open Modal -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="display-6">@totalEntries Khula Records Found</h1>
    <button class="btn btn-success btn-lg" @onclick="OpenAddModal">+ Add New Siyajat</button>
</div>

<!-- Khula List -->
<KhulaList KhulaEntries="@KhulaEntries"
           OnEdit="HandleEdit"
           OnDelete="OpenDeleteConfirmation"
           IsLoading="IsLoading" />

<!-- Pagination Component -->
<PaginationComponent CurrentPage="currentPage"
                     TotalPages="totalPages"
                     OnPageChanged="GoToPage"
                     OnPageSizeChanged="OnPageSizeChanged" />

<!-- Khula Form Modal -->
<KhulaForm @bind-IsModalVisible="isModalVisible"
             KhulaModel="@selectedKhula"
             IsEditMode="@isEditMode"
             OnSubmit="HandleSubmit"
             OnCancel="HandleCancel" />

<!-- Delete Confirmation Dialog -->
<DialogComponent DialogBoxModel="DialogBoxModel" />