@page "/profile"

@inject IUserProfileService ProfileService
@inject IJSRuntime JS

<div class="container-fluid p-4">
    <h3 class="fw-bold text-dark mb-4"><i class="bi bi-person-badge-fill text-success"></i> My Profile Settings</h3>

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @SuccessMessage
            <button type="button" class="btn-close" @onclick="() => SuccessMessage = null" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @ErrorMessage
            <button type="button" class="btn-close" @onclick="() => ErrorMessage = null" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 p-4">
                <h5 class="fw-bold mb-3 text-secondary border-bottom pb-2">
                    <i class="bi bi-person-vcard"></i> Personal Details
                </h5>

                <EditForm Model="ProfileModel" OnValidSubmit="HandleProfileUpdate">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name</label>
                        <InputText class="form-control form-control-lg" @bind-Value="ProfileModel.FullName" placeholder="Enter full name" />
                        <ValidationMessage For="@(() => ProfileModel.FullName)" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mobile Number</label>
                        <InputText class="form-control form-control-lg" @bind-Value="ProfileModel.MobileNumber" placeholder="Enter mobile number" />
                        <ValidationMessage For="@(() => ProfileModel.MobileNumber)" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <InputText class="form-control form-control-lg" @bind-Value="ProfileModel.Email" readonly placeholder="Enter Email" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Address</label>
                        <InputTextArea class="form-control" @bind-Value="ProfileModel.Address" rows="4" placeholder="Enter complete address" />
                        <ValidationMessage For="@(() => ProfileModel.Address)" class="text-danger small" />
                    </div>

                    <button type="submit" class="btn btn-success w-100 fw-bold py-2 mt-2" disabled="@IsLoading">
                        @if (IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Save Personal Information
                    </button>
                </EditForm>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 p-4">
                <h5 class="fw-bold mb-3 text-secondary border-bottom pb-2">
                    <i class="bi bi-shield-lock"></i> Security Credentials
                </h5>

                <EditForm Model="PasswordModel" OnValidSubmit="HandlePasswordUpdate">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Current Password</label>
                        <InputText type="password" class="form-control form-control-lg" @bind-Value="PasswordModel.CurrentPassword" placeholder="••••••••" />
                        <ValidationMessage For="@(() => PasswordModel.CurrentPassword)" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">New Password</label>
                        <InputText type="password" class="form-control form-control-lg" @bind-Value="PasswordModel.NewPassword" placeholder="••••••••" />
                        <ValidationMessage For="@(() => PasswordModel.NewPassword)" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Confirm New Password</label>
                        <InputText type="password" class="form-control form-control-lg" @bind-Value="PasswordModel.ConfirmPassword" placeholder="••••••••" />
                        <ValidationMessage For="@(() => PasswordModel.ConfirmPassword)" class="text-danger small" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2 mt-2" disabled="@IsPasswordLoading">
                        @if (IsPasswordLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Change Account Password
                    </button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private MyProfileViewModel ProfileModel = new();
    private ChangePasswordViewModel PasswordModel = new();

    private string? SuccessMessage;
    private string? ErrorMessage;

    private bool IsLoading = false;
    private bool IsPasswordLoading = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Initial load par database se values uthake fields me fill karega
            ProfileModel = await ProfileService.GetCurrentProfileAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Profile load karne me dikkat aayi: {ex.Message}";
        }
    }

    private async Task HandleProfileUpdate()
    {
        IsLoading = true;
        SuccessMessage = null;
        ErrorMessage = null;

        try
        {
            await ProfileService.UpdateProfileAsync(ProfileModel);
            SuccessMessage = "Personal information updated successfully.";
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Update failed: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandlePasswordUpdate()
    {
        IsPasswordLoading = true;
        SuccessMessage = null;
        ErrorMessage = null;

        try
        {
            var result = await ProfileService.ChangePasswordAsync(PasswordModel);

            if (result.IsSuccess)
            {
                SuccessMessage = "Password changed successfully.";
                PasswordModel = new(); // Form fields reset karne ke liye
            }
            else
            {
                ErrorMessage = result.Error ?? "Password change fails. Purana password galat ho sakta hai.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            IsPasswordLoading = false;
            StateHasChanged();
        }
    }
}