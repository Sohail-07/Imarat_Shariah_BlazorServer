@page "/siyajat"
@using Imarat_Shariah.Components.CoomonComponents


<!-- Alert -->
@if (showToaster)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>@ToasterHeading</strong> @ToasterBody
        <button type="button" class="btn-close" @onclick="HideToaster" aria-label="Close"></button>
    </div>
}


<!-- Search Bar -->
<SiyajatSearchBarComponent OnSearch="HandleSearch" />

<!-- Button to open Modal -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="display-6">Siyajat List</h1>
    <button class="btn btn-success btn-lg" @onclick="OpenAddModal">+ Add New Siyajat</button>
</div>

<!-- Siyajat List -->
<SiyajatList SiyajatEntries="@SiyajatEntries" OnEdit="HandleEdit" OnDelete="OpenDeleteConfirmation" />

<!-- Siyajat Form Modal -->
<SiyajatForm @bind-IsModalVisible="isModalVisible"
             SiyajatModel="@selectedSiyajat"
             IsEditMode="@isEditMode"
             OnSubmit="HandleSubmit"
             OnCancel="HandleCancel" />


<!-- Delete Confirmation Dialog -->
<DialogComponent DialogBoxModel="DialogBoxModel" />