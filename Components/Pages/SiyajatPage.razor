@page "/siyajat"
@using Imarat_Shariah.Components.CoomonComponents

<!-- Button to open Modal -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Siyajat List</h1>
    <button class="btn btn-success" @onclick="OpenAddModal">Add New Siyajat</button>
</div>

<!-- Siyajat List -->
<SiyajatList SiyajatEntries="@SiyajatEntries" OnEdit="HandleEdit" OnDelete="OpenDeleteConfirmation" />

<!-- Siyajat Form Modal -->
<SiyajatForm @bind-IsModalVisible="isModalVisible"
             SiyajatModel="@selectedSiyajat"
             IsEditMode="@isEditMode"
             OnSubmit="HandleSubmit"
             OnCancel="HandleCancel" />

<!-- Delete Confirmation Dialog -->
<DialogComponent DialogBoxModel="DialogBoxModel" />