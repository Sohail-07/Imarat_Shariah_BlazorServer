<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <!-- AuthorizeRouteView will scan custom attributes on components automatically -->
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <div class="alert alert-danger p-5 m-5 text-center">
                        <h4>Aapke paas is page ko access karne ki permission nahi hai!</h4>
                        <p>Kripya portal admin se contact karein.</p>
                    </div>
                </NotAuthorized>
                <Authorizing>
                    <p class="text-center p-5">Security context verifying, please wait...</p>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>