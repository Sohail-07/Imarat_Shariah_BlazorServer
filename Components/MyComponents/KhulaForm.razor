<div class="modal fade @(IsModalVisible ? "show d-block" : "d-none")" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalLabel">@GetTitle()</h5>
                <button type="button" class="btn-close" @onclick="CloseModal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <EditForm Model="@KhulaModel" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    @* <ValidationSummary class="text-danger" /> *@

                    <div class="row">
                        <!-- First Column: Form Data -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="formNo" class="form-label">Form No</label>
                                <InputText id="formNo" class="form-control" @bind-Value="KhulaModel.FormNumber" />
                                <ValidationMessage For="@(() => KhulaModel.FormNumber)" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="nikahDate" class="form-label">Nikah Date</label>
                                <InputDate id="nikahDate" class="form-control" @bind-Value="KhulaModel.NikahDate" />
                                <ValidationMessage For="@(() => KhulaModel.NikahDate)" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="groomName" class="form-label">Groom Name</label>
                                <InputText id="groomName" class="form-control" @bind-Value="KhulaModel.GroomName" />
                                <ValidationMessage For="@(() => KhulaModel.GroomName)" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="brideName" class="form-label">Bride Name</label>
                                <InputText id="brideName" class="form-control" @bind-Value="KhulaModel.BrideName" />
                                <ValidationMessage For="@(() => KhulaModel.BrideName)" class="text-danger" />
                            </div>
                        </div>

                        <!-- Second Column: PDF Upload Area -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Upload PDF:</label>
                                <input type="file" @onchange="HandleFileSelected" class="form-control" accept="application/pdf" />
                            </div>
                            <div class="drag-drop-area" @ondrop="HandleDrop" @ondragover="HandleDragOver" style="border: 2px dashed #007bff; padding: 20px; text-align: center;">
                                <p>Drag and drop PDF here, or click to browse.</p>
                                @if (PdfFileName != null)
                                {
                                    <p><strong>Selected File:</strong> @PdfFileName</p>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>
                        <button type="submit" class="btn btn-success">Submit</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>
