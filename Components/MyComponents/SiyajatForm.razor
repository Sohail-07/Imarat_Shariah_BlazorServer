<div class="modal fade @(IsModalVisible ? "show d-block" : "d-none")" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalLabel">@GetTitle()</h5>
                <button type="button" class="btn-close" @onclick="CloseModal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <EditForm Model="@SiyajatModel" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    @* <ValidationSummary class="text-danger" /> *@

                    <div class="row">
                        <!-- First Column: Form Data -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="formNo" class="form-label">Form No</label>
                                <InputText id="formNo" class="form-control" @bind-Value="SiyajatModel.FormNo" />
                                <ValidationMessage For="@(() => SiyajatModel.FormNo)" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="qazatNo" class="form-label">Qazat No</label>
                                <InputText id="qazatNo" class="form-control" @bind-Value="SiyajatModel.QazatNo" />
                                <ValidationMessage For="@(() => SiyajatModel.QazatNo)" class="text-danger" />
                            </div>
                            <div class="mb-3">
                                <label for="formType" class="form-label">Form Type</label>
                                <InputSelect id="formType" class="form-control" @bind-Value="SiyajatModel.FormType">
                                    <option value="">-- Select Form Type --</option>
                                    <option value="Type1">Type1</option>
                                    <option value="Type2">Type2</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => SiyajatModel.FormType)" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="nikahDate" class="form-label">Nikah Date</label>
                                <InputDate id="nikahDate" class="form-control" @bind-Value="SiyajatModel.NikahDate" />
                                <ValidationMessage For="@(() => SiyajatModel.NikahDate)" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="groomName" class="form-label">Groom Name</label>
                                <InputText id="groomName" class="form-control" @bind-Value="SiyajatModel.GroomName" />
                                <ValidationMessage For="@(() => SiyajatModel.GroomName)" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="brideName" class="form-label">Bride Name</label>
                                <InputText id="brideName" class="form-control" @bind-Value="SiyajatModel.BrideName" />
                                <ValidationMessage For="@(() => SiyajatModel.BrideName)" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="qariName" class="form-label">Qari Name</label>
                                <InputText id="qariName" class="form-control" @bind-Value="SiyajatModel.QariName" />
                                <ValidationMessage For="@(() => SiyajatModel.QariName)" class="text-danger" />
                            </div>
                           
                        </div>

                        <!-- Second Column: PDF Upload Area -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Upload PDF:</label>
                                <InputFile id="fileUpload" OnChange="HandleFileSelected" class="form-control" accept="application/pdf" />
                            </div>
                            <div class="drag-drop-area" @ondrop="HandleDrop" @ondragover="HandleDragOver" style="border: 2px dashed #007bff; padding: 20px; text-align: center;">
                                <p>Drag and drop PDF here, or click to browse.</p>
                                @if (SiyajatModel.PreviewFileUrl != null)
                                {
                                    <p><strong>Selected File:</strong> @* @SiyajatModel.PreviewFileUrl *@ </p>
                                    <iframe src="@SiyajatModel.PreviewFileUrl" style="width: 100%; height: 400px; border: 1px solid #ccc;" />
                                }
                                @if (!string.IsNullOrEmpty(ErrorMessage))
                                {
                                    <div class="alert alert-danger mt-3">
                                        @ErrorMessage
                                    </div>
                                }
                            </div>
                            @if (SiyajatModel.PDFPath != null || SiyajatModel.PreviewFileUrl != null)
                            {
                                <button type="button" class="btn btn-primary" @onclick="RemovePDF">Remove PDF</button>
                            }
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>
                        <button type="submit" class="btn btn-success">Submit</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

<LoaderComponent _isLoading="IsLoading" _colorClass="text-success" />