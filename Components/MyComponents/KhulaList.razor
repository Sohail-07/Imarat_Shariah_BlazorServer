@if (!KhulaEntries.Any())
{
    <div class="alert alert-dark" role="alert">
        No Khula entries found.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle">
            <thead class="table-success">
                <tr>
                    <th scope="col">Form No</th>
                    <th scope="col">Nikah Date</th>
                    <th scope="col">Groom Name</th>
                    <th scope="col">Bride Name</th>
                    <th scope="col" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var siyajat in KhulaEntries)
                {
                    <tr>
                        <td>@siyajat.FormNumber</td>
                        <td>@_timeConversion.GetIndianStandardTime(siyajat.NikahDate).ToString("dd MMMM yyyy")</td>
                        <td>@siyajat.GroomName</td>
                        <td>@siyajat.BrideName</td>
                        <td class="text-center">
                            <button class="btn btn-success btn-sm me-2" title="Edit" @onclick="() => OnEdit.InvokeAsync(siyajat.Id)">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button class="btn btn-danger btn-sm" title="Delete" @onclick="() => OnDelete.InvokeAsync(siyajat)">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
<LoaderComponent _isLoading="IsLoading" _colorClass="text-success" />