@if (SiyajatEntries == null)
{
    <p class="text-center">Loading...</p>
}
else if (!SiyajatEntries.Any())
{
    <p class="text-center">No Siyajat entries found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered">
            <thead class="table-light">
                <tr>
                    <th scope="col">Form No</th>
                    <th scope="col">Qazat No</th>
                    <th scope="col">Nikah Date</th>
                    <th scope="col">Form Type</th>
                    <th scope="col">Groom Name</th>
                    <th scope="col">Bride Name</th>
                    <th scope="col" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var siyajat in SiyajatEntries)
                {
                    <tr>
                        <td>@siyajat.FormNo</td>
                        <td>@siyajat.QazatNo</td>
                        <td>@_timeConversion.GetIndianStandardTime(siyajat.NikahDate)</td>
                        <td>@siyajat.FormType</td>
                        <td>@siyajat.GroomName</td>
                        <td>@siyajat.BrideName</td>
                        <td class="text-center">
                            <button class="btn btn-primary btn-sm" title="Edit" @onclick="() => OnEdit.InvokeAsync(siyajat.Id)">
                                Edit
                            </button>
                            <button class="btn btn-danger btn-sm" title="Delete" @onclick="() => OnDelete.InvokeAsync(siyajat)">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
